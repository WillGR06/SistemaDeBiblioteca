-- =====================================================================
-- TRIGGERS: AUDITORIA DO ADMINISTRADOR
-- O site deve executar, após o login do admin e na mesma conexão:
--   SET @id_admin = <id_usuario do administrador>;
-- Sem essa variável, nenhum log é gravado.
-- =====================================================================

-- TRIGGER trg_obra_bi: preenche automaticamente qual administrador cadastrou a obra (@id_admin).
DROP TRIGGER IF EXISTS trg_obra_bi$$
CREATE TRIGGER trg_obra_bi BEFORE INSERT ON obra
FOR EACH ROW
BEGIN
  IF NEW.id_admin_cadastro IS NULL THEN
    SET NEW.id_admin_cadastro = @id_admin;
  END IF;
END$$

-- TRIGGER trg_obra_ai: grava no log_administracao quando uma obra é cadastrada.
DROP TRIGGER IF EXISTS trg_obra_ai$$
CREATE TRIGGER trg_obra_ai AFTER INSERT ON obra
FOR EACH ROW
BEGIN
  IF @id_admin IS NOT NULL THEN
    INSERT INTO log_administracao (id_administrador, tabela_afetada, id_registro, acao, descricao)
    VALUES (@id_admin, 'obra', NEW.id_obra, 'inserir', CONCAT('Obra cadastrada: ', NEW.titulo));
  END IF;
END$$

